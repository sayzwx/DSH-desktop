{
  "name": "dsh",
  "version": "0.6.3",
  "description": "DSH 桌面端（DeepSeek Harness Desktop）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke-renderer.cjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.sayzwx.dsh",
    "productName": "DSH",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "config/**/*",
      "installer/setup.sh",
      "installer/check-env.sh",
      "package.json"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "sayzwx",
      "synopsis": "DeepSeek Harness Desktop",
      "description": "Electron shell for the DeepSeek Harness engine: sessions, tool cards, subagents, trajectory, diagnostics.",
      "desktop": {
        "Name": "DSH",
        "Comment": "DeepSeek Harness Desktop",
        "Categories": "Development;Utility;",
        "StartupNotify": "true"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
