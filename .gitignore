# 依赖
node_modules/

# 运行日志
*.log

# 本地环境变量 / 密钥（不要入库）
.env

# 独立工程：Wallpaper Engine 壁纸（非桌面端 UI 本体）
wallpaper-engine/

# 便携版应用运行时（含 Electron 二进制，不入库）
app/

# 系统杂物
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/
*.pyc

# 实测/临时产物
scripts/.scratch/

# 分发安装包构建产物
dist/

# WorkBuddy 本地元数据（含记忆/可能的本地密钥，禁止入库）
.workbuddy/

# DSH 桌面端安装产物（本机安装目录，勿入库）
DSH/

# 内置 dsh-market tarball（由 scripts/fetch-dshmarket.ps1 拉取，体积较大不入库；保留 manifest.json 入库）
extras/dsh-market-bundle/*.tgz
